# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
#
# Local-only values go in .env.local, which is not deployed:
# PORT=3002
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Server
# PORT and GOOGLE_APPLICATION_CREDENTIALS belong in .env.local (local only).
# Cloud Functions rejects PORT, and it already has its own credentials.
FRONTEND_URL=http://localhost:5173

# Storage bucket for product images (required at startup)
STORAGE_BUCKET=your_firebase_storage_bucket

# Firebase Authentication UIDs allowed to use the admin API.
# Separate several UIDs with commas.
# A user with the custom claim admin=true is also allowed.
# Set that claim with: npm run set-admin -- <firebase-uid>
ADMIN_UID=your_firebase_admin_uid

# DeepL API (used by the admin panel to translate UK -> EN)
DEEPL_API_KEY=your_deepl_api_key

# Telegram (the bot sends a private message to each recipient)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Comma-separated Telegram user ids. Each person must open the bot and press Start.
TELEGRAM_RECIPIENT_IDS=
